# Azure AI Foundry: paste values from your model deployment here.
# Match the API in your deployment example: chat_completions or responses.
LLM_API=chat_completions
LLM_PROVIDER=azure_foundry
AZURE_OPENAI_API_KEY=
# Example: https://your-resource.openai.azure.com
# Also accepts https://your-resource.services.ai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=
# Deployment NAME from Foundry (not necessarily the underlying model name).
# Used for both report chat and receipt autofill; select a vision-capable
# deployment supporting structured JSON output (for example, grok-4.7).
AZURE_OPENAI_DEPLOYMENT=

# Optional alternative: set LLM_PROVIDER=openai to use these instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
